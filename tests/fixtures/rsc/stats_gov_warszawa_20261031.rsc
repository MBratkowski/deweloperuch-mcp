49:["$","section",null,{"className":"bg-gray-50 border border-gray-200 rounded-2xl p-5 cq-md:p-6 text-sm text-gray-700 space-y-3","children":[[["$","h2",null,{"className":"text-base font-semibold text-gray-900 mb-1","children":"O danych NBP"}],["$","p",null,{"children":["Narodowy Bank Polski publikuje kwartalne raporty „Informacja o cenach mieszkań i sytuacji na rynku nieruchomości” zawierające średnie cen ofertowych i transakcyjnych mieszkań w 17 największych miastach. Źródłem jest"," ",["$","strong",null,{"children":"Baza Rynku Nieruchomości (BaRN)"}]," NBP - dane zbierane są ankietowo od pośredników nieruchomości i deweloperów. BaRN nie jest pełnym rejestrem transakcji, lecz próbą opartą o sprawozdania uczestników rynku."]}],["$","p",null,{"children":[["$","strong",null,{"children":"Pierwotny"}]," oznacza nowe mieszkania od deweloperów, ",["$","strong",null,{"children":"wtórny"}]," - używane mieszkania od osób prywatnych. Cena ",["$","strong",null,{"children":"ofertowa"}]," to cena z ogłoszenia (oferty sprzedaży), ",["$","strong",null,{"children":"transakcyjna"}]," - cena z faktycznej umowy sprzedaży raportowana do BaRN przez pośrednika lub dewelopera."]}]],[["$","h2",null,{"className":"text-base font-semibold text-gray-900 mt-3 mb-1","children":"O danych GUS BDL"}],["$","p",null,{"children":"Bank Danych Lokalnych Głównego Urzędu Statystycznego zbiera miesięczne dane o liczbie mieszkań oddanych do użytkowania i rozpoczętych budów (formularze B-05 / B-09) oraz roczne statystyki demograficzne. Dla porównania z NBP agregujemy miesięczne wartości do kwartałów."}]]]}]
