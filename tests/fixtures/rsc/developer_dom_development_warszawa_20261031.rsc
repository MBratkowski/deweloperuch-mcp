1d:T416,{"@context":"https://schema.org","@type":"WebPage","name":"Ceny Ofertowe Deweloperów - Warszawa","description":"Aktualne ceny ofertowe deweloperów w Warszawie. Średnia cena: 18,568 zł/m². Średnia powierzchnia: 49.03m². Analiza rynku nieruchomości.","url":"https://deweloperuch.pl/ceny-ofertowe/warszawa/deweloperzy","mainEntity":{"@type":"RealEstateListing","name":"Ceny Ofertowe Deweloperów - Warszawa","description":"Aktualne ceny ofertowe deweloperów w Warszawie. Średnia cena: 18,568 zł/m². Średnia powierzchnia: 49.03m². Analiza rynku nieruchomości.","addressRegion":"Warszawa","addressCountry":"PL","numberOfItems":1816,"offers":{"@type":"AggregateOffer","priceCurrency":"PLN","price":899168,"offerCount":1816,"priceSpecification":{"@type":"UnitPriceSpecification","price":18568,"priceCurrency":"PLN","unitCode":"MTK","unitText":"za metr kwadratowy"}}},"publisher":{"@type":"Organization","name":"Deweloperuch","url":"https://deweloperuch.pl","logo":{"@type":"ImageObject","url":"https://deweloperuch.pl/deweloperuch.svg"}}}1e:T128b,
        .dw-inv-rail { position: sticky; top: 0; height: 100vh; flex: none; z-index: 30; }
        @media (max-width: 1000px) { .dw-inv-rail { display: none; } }
        .dw-inv-content { flex: 1; min-width: 0; }
        .dw-inv-headpad { padding: 18px 1.5rem 0; }
        .dw-inv-main { padding: 26px 1.5rem 60px; }
        .dw-inv-tiles { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
        .dw-inv-cards2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
        @media (max-width: 1000px) {
          .dw-inv-headpad { padding: 14px 16px 0; }
          .dw-inv-main { padding: 18px 16px 48px; }
          .dw-inv-tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); }
          .dw-inv-cards2 { grid-template-columns: 1fr; }
        }
        .dw-inv-skel {
          background: #fff; border: 1px solid #ECEBEF; border-radius: 20px;
          animation: dw-inv-pulse 1.4s ease-in-out infinite;
        }
        @keyframes dw-inv-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.55; } }
        .dw-inv-tile { transition: transform .16s ease, box-shadow .16s ease; }
        .dw-inv-tile:hover {
          transform: translateY(-2px);
          box-shadow: 0 12px 24px -16px rgba(22,20,31,0.35);
        }
        /* Wiersz listy inwestycji - JEDEN DOM na obie szerokości, wzorem
           resultsInvestmentTable.module.css z listy /inwestycje.
           Desktop: miniatura · nazwa · śr. cena · oferty · śr. metraż · bilans.
           <900px: znika śr. metraż. Mobile (<768px, jak na liście wyników):
           dwie kolumny -

             nazwa inwestycji     │ śr. cena
             miasto, ulica        │ zł/m²
             X z Y ofert          │

           miniatura, oferty, metraż, bilans i nagłówek kolumn znikają
           (liczba ofert wraca linijką w komórce nazwy). */
        .dw-dev-inv-grid {
          display: grid;
          grid-template-columns: 64px 1.7fr 1fr 1fr 0.8fr 1fr;
          grid-template-areas: 'thumb name price offers size balance';
          gap: 14px;
          align-items: center;
        }
        .dw-dev-inv-thumb { grid-area: thumb; }
        .dw-dev-inv-name { grid-area: name; }
        .dw-dev-inv-price { grid-area: price; }
        .dw-dev-inv-offers { grid-area: offers; }
        .dw-dev-inv-size { grid-area: size; }
        .dw-dev-inv-balance { grid-area: balance; }
        .dw-dev-inv-offers-inline { display: none; }
        .dw-dev-row:hover { background: #FAF9FC; }
        @media (max-width: 900px) {
          .dw-dev-inv-grid {
            grid-template-columns: 64px 1.6fr 1fr 0.8fr 1fr;
            grid-template-areas: 'thumb name price offers balance';
          }
          .dw-dev-inv-size { display: none; }
        }
        @media (max-width: 767px) {
          /* Szukajka bierze całą wolną szerokość karty, pigułka „Sortuj"
             zostaje kompaktowa (na mobile pokazuje sam napis). */
          .dw-dev-inv-controls { width: 100%; flex-wrap: nowrap; }
          .dw-dev-inv-search { flex: 1 1 auto; width: auto !important; min-width: 0; }
          .dw-dev-inv-grid {
            grid-template-columns: minmax(0, 1fr) auto;
            grid-template-areas: 'name price';
            gap: 10px;
            align-items: start;
          }
          .dw-dev-inv-head { display: none; }
          .dw-dev-inv-thumb,
          .dw-dev-inv-offers,
          /* Bilans niesie inline display: flex - bez !important nie zniknie. */
          .dw-dev-inv-balance { display: none !important; }
          .dw-dev-inv-offers-inline { display: block; }
          /* Stała szerokość kolumny cen: kwoty nie „pływają" między wierszami. */
          .dw-dev-inv-price { min-width: 92px; text-align: right; }
        }
        .dw-dev-cities { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
        @media (max-width: 1000px) { .dw-dev-cities { grid-template-columns: repeat(2, 1fr); } }
        @media (max-width: 560px) { .dw-dev-cities { grid-template-columns: 1fr; } }
        .dw-dev-competitors { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
        @media (max-width: 700px) { .dw-dev-competitors { grid-template-columns: 1fr; } }
        .dw-dev-bar-tip {
          position: absolute; left: 0; bottom: calc(100% + 8px); z-index: 5;
          padding: 6px 10px; border-radius: 8px;
          background: #16151C; color: #fff;
          font-size: 12px; font-weight: 600; white-space: nowrap;
          opacity: 0; transform: translateY(3px); pointer-events: none;
          transition: opacity .14s ease, transform .14s ease;
        }
        .dw-dev-bar-cell:hover .dw-dev-bar-tip { opacity: 1; transform: translateY(0); }
