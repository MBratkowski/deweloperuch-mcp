47:[["$","$L57",null,{"spec":{"id":"rozklad-metrazy","title":"Rozkład metraży","headingLevel":2,"info":["Wszystkie monitorowane lokale dewelopera w czterech klasach metrażu: w ofercie po prawej, archiwalne — te, których nie ma już w ofercie — po lewej. Obie strony mają jedną skalę."],"summary":"Najwięcej lokali w klasie 55–70 m² (3 pok.): 88 z 227 (38,8 %).","source":"Oferty deweloperów w bazie Deweloperucha","sourceNote":"Dane przedstawione na wykresie pochodzą z publicznie dostępnych źródeł, dlatego nie odpowiadamy za ich poprawność, kompletność ani aktualność.","left":{"key":"archiwalne","label":"Archiwalne","color":"#9A98A3"},"right":{"key":"oferta","label":"W ofercie","color":"#7C3AED"},"frames":[{"key":"teraz","label":"Dziś","rows":[{"key":"k0","label":"do 35 m²","sub":"1 pok. · 0,4 % lokali","left":1,"right":0},{"key":"k1","label":"35–55 m²","sub":"2 pok. · 28,2 % lokali","left":44,"right":20},{"key":"k2","label":"55–70 m²","sub":"3 pok. · 38,8 % lokali","left":63,"right":25},{"key":"k3","label":"powyżej 70 m²","sub":"4+ pok. · 32,6 % lokali","left":59,"right":15}],"header":{"value":"227 lokali","caption":"60 w ofercie · 167 archiwalnych · 26,4 % w ofercie","changes":[]}}],"frameLabel":null,"density":"normal","surplus":false,"scaleMax":63,"ticks":[],"rowColumn":"Metraż","rowPrefix":"","noun":["lokal","lokale","lokali"],"rowExtra":"share-right","emptyText":"Brak danych o metrażach lokali."}}],["$","$L58",null,{"spec":{"id":"oferty-wg-metrazu","title":"Aktualne oferty wg metrażu","headingLevel":2,"info":["Wszystkie inwestycje dewelopera: aktualne oferty w przedziałach metrażu po 5 m²; kolor słupka mówi, czy cena zmieniła się od wystawienia. „Wartość” to suma cen ofert ze wzrostem albo spadkiem od cen startowych."],"summary":"60 aktualnych ofert: 2 bez zmiany ceny, 54 po obniżce i 4 po podwyżce; łączna wartość 59,60 mln zł.","source":"Oferty deweloperów w bazie Deweloperucha","sourceNote":"Dane przedstawione na wykresie pochodzą z publicznie dostępnych źródeł, d